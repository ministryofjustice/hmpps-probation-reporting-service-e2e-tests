{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": [
      "node",
      "playwright",
      "@axe-core/playwright"
    ],
    "sourceMap": false,
    "declaration": true,
    "declarationMap": false,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@tests/*": [
        "psr_tests/tests/*"
      ],
      "@utils/*": [
        "psr_tests/utils/*"
      ],
      "@test-data/*": [
        "psr_tests/test-data/*"
      ],
      "@pages/*": [
        "psr_tests/pages/*"
      ],
      "@fixtures/*": [
        "psr_tests/fixtures/*"
      ],
      "@env-config/*": [
        "psr_tests/env-config/*"
      ],
      "root/*": [
        "./*"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "node_modules",
    "dist",
    "assets/**/*.js",
    "coverage",
    "test_results",
    "playwright.config.ts",
    "allure-report/**/*.js"
  ],
  "include": [
    "**/*.ts",
    "**/*.js"
  ]
}